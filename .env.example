# Chat responses: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Supabase authentication (recommended for real accounts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional video provider adapter. Must accept POST JSON {prompt}.
# Configure these on Vercel too. Never expose secret keys in NEXT_PUBLIC variables.
VIDEO_API_URL=
VIDEO_API_KEY=
